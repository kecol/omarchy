#!/bin/bash

# omarchy:summary=Choose a coding agent interactively or launch an explicit/default agent
# omarchy:args=[--inline] [--pick] [--agent=NAME] [--directory=PATH] [--host|--container] [--local] [--local-model <recipe>] [--prefer-local] [--check] [--installed-only]
# omarchy:examples=omarchy agent | omarchy agent --inline | omarchy agent --host --local

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

inline=false
pick=false
oneshot=false
session_action=
selected_agent=
execution_mode_override=
project_directory=
checking=false
installed_only=false
use_local=false
local_requested=false
prefer_local=false
local_model=""

# Flags only. A bare prompt would shadow the subcommands under this group, so
# prompts go through omarchy-agent-prompt, which passes one here as --prompt.
while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --pick)
      pick=true
      shift
      ;;
    --oneshot)
      oneshot=true
      inline=true
      shift
      ;;
    --host)
      execution_mode_override=host
      shift
      ;;
    --container)
      execution_mode_override=container
      shift
      ;;
    --local)
      use_local=true
      local_requested=true
      shift
      ;;
    --local-model)
      use_local=true
      local_requested=true
      local_model=${2:?--local-model needs a recipe id}
      shift 2
      ;;
    --prefer-local)
      prefer_local=true
      shift
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    --resume-session)
      session_action=resume
      shift
      ;;
    --continue-session)
      session_action=continue
      shift
      ;;
    --agent=*)
      selected_agent=${1#--agent=}
      if [[ -z $selected_agent ]]; then
        echo "--agent needs a value" >&2
        exit 1
      fi
      shift
      ;;
    --directory=*)
      project_directory=${1#--directory=}
      if [[ -z $project_directory ]]; then
        echo "--directory needs a value" >&2
        exit 1
      fi
      shift
      ;;
    --agent | --agent-internal)
      selected_agent=${2:?--agent needs a value}
      shift 2
      ;;
    --directory)
      project_directory=${2:?--directory needs a value}
      shift 2
      ;;
    --check)
      checking=true
      shift
      ;;
    --installed-only)
      installed_only=true
      shift
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: omarchy agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from the keybinding or
# menu start in the work directory instead of re-asking on every session.
if [[ -n $project_directory ]]; then
  cd -- "$project_directory" || exit 1
elif [[ $PWD == "$HOME" && -d $HOME/Work ]]; then
  cd "$HOME/Work" || exit 1
fi

if [[ -n $selected_agent ]]; then
  agent=$selected_agent
elif ! agent=$(omarchy-default-agent); then
  exit 1
fi

if ! execution_mode=${execution_mode_override:-$(omarchy-agent-mode)}; then
  exit 1
fi
if [[ $execution_mode != "host" && $execution_mode != "container" ]]; then
  echo "Invalid agent execution mode: $execution_mode" >&2
  exit 1
fi

# Upstream local overlays name Host paths. Never pass those paths into a
# container, broaden its mounts/network, or change the saved execution mode.
if [[ $use_local == "true" && $execution_mode != "host" ]]; then
  echo "Local model overlays require Host mode; use --host explicitly for this launch." >&2
  if [[ $checking == "false" && ! -t 2 ]]; then
    omarchy-notification-send -u critical "$(omarchy-i18n agents.localHostOnly)" "$(omarchy-i18n agents.localHostOnlyBody)"
  fi
  exit 1
fi

# Preference is advisory, Host-only, and never replaces an explicit unsupported
# agent. Checks inspect availability only, not model services or overlay state.
if [[ $prefer_local == "true" && $use_local == "false" && $execution_mode == "host" && $checking == "false" ]] &&
  { [[ -z $selected_agent ]] || [[ $selected_agent == "pi" || $selected_agent == "opencode" ]]; }; then
  local_model=$(omarchy-agent-local status --json 2>/dev/null | jq -r '
    [.models // {} | to_entries[] | select(.value.unit == "active" and .value.sub_state == "running") | .key] as $up
    | if (.last as $last | $up | index($last)) != null then .last else ($up[0] // empty) end' 2>/dev/null)
  [[ -n $local_model ]] && use_local=true
fi

# An explicit local request may use an installed compatible agent when the
# saved default has no overlay, but must not replace --agent or install a shim.
if [[ $use_local == "true" && $agent != "pi" && $agent != "opencode" ]]; then
  if [[ -n $selected_agent ]]; then
    echo "Local model overlays support Pi and OpenCode; the explicit agent was not changed." >&2
    exit 1
  fi
  local_agent=""
  for candidate in pi opencode; do
    if "$script_dir/omarchy-agent-host-command" "$candidate" >/dev/null 2>&1; then
      local_agent=$candidate
      break
    fi
  done
  if [[ -n $local_agent ]]; then
    agent=$local_agent
  elif [[ $prefer_local == "true" && $local_requested == "false" ]]; then
    use_local=false
  else
    echo "Install Pi or OpenCode explicitly before launching a local model." >&2
    if [[ $checking == "false" && ! -t 2 ]]; then
      omarchy-notification-send -u critical "$(omarchy-i18n agents.localUnsupported)" "$(omarchy-i18n agents.localUnsupportedBody)"
    fi
    exit 1
  fi
fi
if [[ $use_local == "true" ]]; then
  installed_only=true
fi

# Explicit/resolved local launches already select their compatible agent.
# Automation, checks, recovery and explicit agents must not acquire a prompt.
if [[ -z $selected_agent && $use_local == "false" && $checking == "false" && $oneshot == "false" && -z $session_action &&
      ${OMARCHY_AGENT_MANAGED:-false} != "true" && ${OMARCHY_AGENT_ONESHOT:-false} != "true" &&
      ${OMARCHY_AGENT_ONESHOT:-0} != "1" && -t 0 && -t 1 && -t 2 ]] &&
  { [[ $pick == "true" ]] || [[ ! -v prompt && $installed_only == "false" ]]; }; then
  mode_source=saved
  if [[ -n $execution_mode_override ]]; then
    mode_source=override
  fi
  if chosen=$(python3 -I -B "$OMARCHY_PATH/default/agents/launch-menu.py" --cli-pick "$execution_mode" "$agent" "$mode_source"); then
    agent=$chosen
    # Like the desktop launch picker, do not install/update a lazy host shim.
    if [[ $execution_mode == "host" ]]; then
      installed_only=true
    fi
  else
    status=$?
    if (( status == 130 )); then
      exit 0
    fi
    exit "$status"
  fi
fi

if [[ -z $agent ]]; then
  echo "Choose default agent with: omarchy default agent <name>, or use --agent NAME for one launch." >&2
  exit 1
fi
if [[ $execution_mode == "host" && -d ${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/agents/command-guards/bin ]]; then
  source "$OMARCHY_PATH/default/agents/guard-path.sh" || exit 1
  omarchy_agent_guard_unpath
fi
# OpenClaw's launcher sets OpenClaw up when the package became the seed before
# this user's OpenClaw moved, so with the package a missing command is its to fix.
# Container launches resolve their command inside the harness, not on the host.
if [[ $checking == "false" && $installed_only == "false" && $execution_mode == "host" ]] && omarchy-cmd-missing "$agent" &&
  ! { [[ $agent == "openclaw" ]] && omarchy-pkg-present openclaw; }; then
  echo "$agent is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  if [[ -n $selected_agent && ! -t 2 ]]; then
    omarchy-notification-send "$(omarchy-i18n agents.harnessMissing "$agent")" "$(omarchy-i18n agents.harnessMissingBody "$agent")"
  fi
  exit 1
fi

# Agents launched from the keybinding or menu run unattended, so each one starts
# with its own spelling of "don't stop to ask". Pi and Ori have none to skip.
case "$agent" in
opencode)
  command=(opencode --auto)
  [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")
  ;;
agy)
  command=(agy --dangerously-skip-permissions)
  [[ -n ${prompt:-} ]] && command+=(--prompt-interactive "$prompt")
  ;;
copilot)
  command=(copilot --allow-all)
  [[ -n ${prompt:-} ]] && command+=(--interactive "$prompt")
  ;;
crush)
  # --yolo belongs to the interactive command only; `crush run` never prompts.
  if [[ -n ${prompt:-} ]]; then
    command=(crush run "$prompt")
  else
    command=(crush --yolo)
  fi
  [[ $oneshot == "true" && -n ${prompt:-} ]] && oneshot_supported=true
  ;;
claude)
  command=(claude --permission-mode auto)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
grok)
  command=(grok --permission-mode bypassPermissions)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
openclaw)
  # The launcher owns onboarding and the gateway dance: OpenClaw's terminal UI
  # must attach to the running gateway (the embedded `openclaw chat` refuses to
  # start while the gateway owns the state directory). It has no permission
  # prompts to skip, and --message seeds the session while keeping it
  # interactive.
  command=(omarchy-launch-openclaw --tui)
  [[ -n ${prompt:-} ]] && command+=(--message "$prompt")
  ;;
codex)
  command=(codex --approve-for-me)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
cursor-agent)
  # --yolo covers commands only; the workspace trust dialog has its own flag.
  # A one-word prompt naming a subcommand (update, login, help) still runs that
  # subcommand after a bare --, so the agent subcommand is named outright, and
  # -- after it keeps a prompt starting with a dash from being read as an option.
  command=(cursor-agent --yolo --trust)
  [[ -n ${prompt:-} ]] && command+=(agent -- "$prompt")
  ;;
hermes)
  if [[ -n ${prompt:-} ]]; then
    command=(env -u HERMES_SESSION_SOURCE hermes chat --yolo --tui "--query=$prompt")
  else
    command=(hermes --yolo)
  fi
  ;;
muse)
  # --approval-mode never skips the tool prompts but keeps Muse's own sandbox.
  command=(muse --approval-mode never)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
omp)
  command=(omp --auto-approve)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
ori)
  # Ori is a harness launcher, and `ori code` is the agent it runs itself.
  if [[ $oneshot == "true" && -n ${prompt:-} ]]; then
    command=(ori code --prompt "$prompt")
    oneshot_supported=true
  else
    # A prompt alone means one headless turn there, printed after the turn ends,
    # so --interactive is what seeds the session with it and keeps the window.
    command=(ori code)
    [[ -n ${prompt:-} ]] && command+=(--interactive --prompt "$prompt")
  fi
  ;;
pi)
  command=(pi)
  if [[ $execution_mode == "host" ]]; then
    command+=(--extension "$OMARCHY_PATH/default/agents/pi/model-recovery.ts")
  fi
  if [[ $oneshot == "true" ]]; then
    command+=(--print)
    oneshot_supported=true
  fi
  [[ -n $session_action ]] && command+=("--$session_action")
  if [[ -n ${prompt:-} ]]; then
    if [[ ${OMARCHY_AGENT_MANAGED:-false} == "true" ]]; then
      command+=(--append-system-prompt "$prompt" "Start the managed task now. The task details and safety rules are in your system instructions.")
    else
      command+=("$prompt")
    fi
  fi
  ;;
kimi)
  # --prompt is non-interactive print mode only; it cannot combine with --yolo.
  if [[ -n ${prompt:-} ]]; then
    command=(kimi --prompt "$prompt")
  else
    command=(kimi --yolo)
  fi
  ;;
qwen)
  # Bind the value so a prompt starting with a dash stays literal.
  command=(qwen --yolo)
  [[ -n ${prompt:-} ]] && command+=("--prompt-interactive=$prompt")
  ;;
dsh)
  # The browser UI has no prompt option, and the headless profile would run the
  # prompt with full access in a window that closes with its answer, so a
  # prompt goes to the clipboard below instead.
  command=(env DSH_PERMISSION_MODE=danger-full-access dsh web)
  prompt_via_clipboard="DeepSeek Harness"
  ;;
mcode)
  # The TUI has no no-approval flag; permission options belong to exec mode.
  command=(mcode)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
kiro-cli)
  # A positional input seeds the interactive chat; -- keeps a prompt starting
  # with a dash literal.
  command=(kiro-cli chat --trust-all-tools)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
freebuff)
  # Freebuff takes no starting prompt and asks no tool permissions, so a
  # prompt goes to the clipboard below instead.
  command=(freebuff)
  prompt_via_clipboard="Freebuff"
  ;;
kilo)
  # Kilo is built on OpenCode and shares its flags. Bind the prompt so one
  # starting with a dash stays literal.
  command=(kilo --auto)
  [[ -n ${prompt:-} ]] && command+=("--prompt=$prompt")
  ;;
devin)
  # A bare positional is a path that opens Devin Desktop, so the prompt
  # always follows --, which starts an interactive session with it.
  command=(devin --permission-mode dangerous --respect-workspace-trust false)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
amp)
  # Amp takes its first interactive message from piped input; a positional
  # message is for --execute, which exits after one turn. The binary rides in
  # as $0 so a user install below can replace it.
  if [[ -n ${prompt:-} ]]; then
    command=(bash -c 'printf "%s\n" "$1" | exec "$0" --dangerously-allow-all' amp "$prompt")
  else
    command=(amp --dangerously-allow-all)
  fi
  ;;
commandcode)
  # --yolo skips permission prompts and implies --trust. A positional prompt
  # seeds the interactive session; -- keeps one starting with a dash literal.
  command=(commandcode --yolo)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
*)
  echo "Unsupported default agent: $agent" >&2
  exit 1
  ;;
esac

if [[ -n $session_action && $agent != "pi" ]]; then
  echo "Session resume commands are currently supported only for Pi." >&2
  exit 1
fi

if [[ $oneshot == "true" ]]; then
  if [[ -z ${prompt:-} ]]; then
    echo "One-shot agent runs need a prompt: omarchy agent prompt --oneshot <prompt...>" >&2
    exit 1
  fi
  if [[ ${oneshot_supported:-false} != "true" ]]; then
    echo "One-shot prompts are not supported for $agent yet." >&2
    exit 1
  fi
fi

if [[ $checking == "true" ]]; then
  if [[ $execution_mode == "container" ]]; then
    exec "$script_dir/omarchy-agent-exec" --container --check "$agent" -- "${command[@]}"
  else
    exec "$script_dir/omarchy-agent-host-command" "$agent"
  fi
fi

if [[ $installed_only == "true" && $execution_mode == "host" ]]; then
  host_command=$("$script_dir/omarchy-agent-host-command" "$agent") || exit 1
  export PATH="${host_command%/*}:$PATH"
  if [[ $agent == "openclaw" ]]; then
    # Menu starts do not install/onboard a gateway service. Attach to an
    # already configured gateway through the installed CLI instead.
    command=("$host_command" tui)
    [[ -n ${prompt:-} ]] && command+=(--message "$prompt")
  elif [[ $agent == "hermes" && ${command[0]} == "env" ]]; then
    command[3]="$host_command"
  else
    # Some launchers wrap the executable in env or bash. Replace the actual
    # agent token, not the wrapper or a prompt argument that happens to match.
    for i in "${!command[@]}"; do
      if [[ ${command[i]} == "$agent" ]]; then
        command[i]=$host_command
        break
      fi
    done
  fi
fi

# --check returns above: it never generates an overlay or queries a model.
# Propagate helper failure even if it printed three lines before failing.
if [[ $use_local == "true" ]]; then
  overlay_text=$(omarchy-agent-local overlay "$agent" ${local_model:+"$local_model"}) || exit 1
  mapfile -t overlay <<<"$overlay_text"
  (( ${#overlay[@]} == 3 )) || exit 1
  case "$agent" in
  opencode)
    # The shared background service never sees the overlay, so run a private one.
    model=$(jq -nc --arg model "${overlay[1]}/${overlay[2]}" '{model: $model}')
    command=(env "OPENCODE_CONFIG=${overlay[0]}" "OPENCODE_CONFIG_CONTENT=$model" "${command[@]}" --standalone)
    ;;
  pi)
    command+=(--extension "${overlay[0]}" --provider "${overlay[1]}" --model "${overlay[2]}")
    ;;
  esac
fi

# An agent with no way to take a starting prompt still opens, with the prompt
# on the clipboard to paste as its first message, so a prompted launch from the
# agents panel or a crash report is not lost.
if [[ $execution_mode == "host" && -n ${prompt:-} && -n ${prompt_via_clipboard:-} ]]; then
  printf '%s' "$prompt" | wl-copy
  omarchy-notification-send -g 󰅇 "$(omarchy-i18n agents.promptOnClipboard "$prompt_via_clipboard")" \
    "$(omarchy-i18n agents.promptOnClipboardBody)"
fi

# omarchy-mise-install's wrappers run `mise use` and `mise x`, current ones on
# lines of their own and older ones after an inline variable; either way
# running one installs the tool it wraps. A symlink is the user's own install.
mise_wrapper() {
  [[ ! -L $1 ]] && head -c 4096 "$1" | grep -qaE 'mise (use|x) '
}

# The user's own install in ~/.local/bin, which omarchy-default-agent counts as
# installed, still wins over mise's lazy shim earlier on PATH, which would
# install and run mise's copy instead. Once mise has installed its own, a
# terminal runs that one, so the launcher does too. Preserve the fork's explicit
# user-install precedence for Cursor and Muse. OpenClaw's command runs its
# launcher, so its prompt is the only argument that could match the name.
user_install="$HOME/.local/bin/$agent"
if [[ $execution_mode == "host" && $installed_only == "false" && $agent != "openclaw" && -f $user_install && -x $user_install ]] &&
  ! mise_wrapper "$user_install" &&
  { [[ $agent == "cursor-agent" || $agent == "muse" ]] || ! MISE_OFFLINE=1 mise -C "$HOME" which "$agent" &>/dev/null; }; then
  for i in "${!command[@]}"; do
    if [[ ${command[i]} == "$agent" ]]; then
      command[i]=$user_install
      break
    fi
  done
fi

# A new session uses the current selection rather than its parent's account
# pin. Explicit provider homes still override the selection. Carry the new pin
# in the command, since terminals launched through uwsm don't inherit our env.
case "$agent" in
claude) home_env="CLAUDE_CONFIG_DIR" ;;
codex) home_env="CODEX_HOME" ;;
grok) home_env="GROK_HOME" ;;
*) home_env="" ;;
esac
if [[ -n $home_env && $execution_mode == "host" ]]; then
  account_pin="OMARCHY_AGENT_${agent^^}_HOME"
  if [[ -v $account_pin && ${!home_env:-} == "${!account_pin}" ]]; then
    unset "$home_env"
  fi
  unset "$account_pin"
  if [[ -z ${!home_env:-} ]]; then
    home=$(omarchy-agent-account-home "$agent")
    account_env=(env -u "$home_env" "$account_pin=$home")
    [[ -n $home ]] && account_env+=("$home_env=$home")
    command=("${account_env[@]}" "${command[@]}")
  fi
fi

if [[ $execution_mode == "container" ]]; then
  command=("$script_dir/omarchy-agent-exec" --container --select-image "$agent" -- "${command[@]}")
  if [[ $oneshot == "true" ]]; then
    command=(env OMARCHY_AGENT_ONESHOT=1 "${command[@]}")
  fi
  # Herdr sees the host container wrapper, not its inner agent executable.
  # Scope the hint to this foreground TUI, never a new terminal or batch job.
  # An explicit value (including empty to opt out) belongs to the caller.
  if [[ $inline == "true" && $oneshot == "false" && ${HERDR_ENV:-} == "1" && ! -v HERDR_AGENT && -t 0 && -t 1 ]]; then
    case "$agent" in
    cursor-agent) herdr_agent=cursor ;;
    pi | omp | claude | codex | opencode | agy | copilot | grok | hermes | muse | kimi) herdr_agent=$agent ;;
    *) herdr_agent= ;;
    esac
    if [[ -n $herdr_agent ]]; then
      command=(env "HERDR_AGENT=$herdr_agent" "${command[@]}")
    fi
  fi
fi

# Resolve the Host escape inside a new terminal too: its service may rebuild
# PATH and reintroduce guards after this launcher's availability checks.
if [[ $execution_mode == "host" && -d ${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/agents/command-guards/bin ]]; then
  command=("$script_dir/omarchy-agent-guards" host -- "${command[@]}")
fi

if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  if [[ -n $project_directory ]]; then
    # uwsm terminal services need not inherit the caller's working directory.
    # Pass it as data and enter it again inside the terminal, not as shell text.
    command=(bash -c 'cd -- "$1" || exit 1; shift; exec "$@"' omarchy-agent "$PWD" "${command[@]}")
  fi
  # A fixed app-id rather than the default org.omarchy.<binary>, so every agent
  # window shares one class for window rules and themes to single out.
  exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
fi
