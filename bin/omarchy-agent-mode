#!/bin/bash

# omarchy:summary=Show or set the execution default for future coding agents
# omarchy:args=[host|container]
# omarchy:examples=omarchy agent mode | omarchy agent mode container

set -euo pipefail

mode_file="$HOME/.config/omarchy/agents/mode"

usage() {
  cat <<'USAGE'
Usage: omarchy agent mode [host|container]

With no argument, prints the launch default. With no saved setting, it is host.
Changes affect future launches only, not running agents or per-launch overrides.
USAGE
}

valid_mode() {
  [[ $1 == "host" || $1 == "container" ]]
}

if (( $# > 1 )); then
  usage >&2
  exit 1
fi

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "")
    # Isolated Python avoids project/user startup hooks. A bounded binary read
    # distinguishes an absent setting from unreadable, malformed, or special files.
    python3 -I - "$mode_file" <<'PY'
import os, stat, sys

path = sys.argv[1]
def invalid():
  sys.exit(f"Invalid agent execution mode in {path}; choose host or container.")

try:
  fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
except FileNotFoundError:
  if os.path.lexists(path):
    invalid()
  print('host')
except OSError:
  invalid()
else:
  with os.fdopen(fd, 'rb') as source:
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
      invalid()
    raw = source.read(11)
  if raw not in (b'host', b'host\n', b'container', b'container\n'):
    invalid()
  print(raw.removesuffix(b'\n').decode('ascii'))
PY
    ;;
  host | container)
    mode=$1
    mode_dir=$(dirname "$mode_file")
    mkdir -p "$mode_dir"
    staged=$(mktemp "$mode_dir/.mode.XXXXXX")
    trap 'rm -f "$staged"' EXIT
    printf '%s\n' "$mode" >"$staged"
    mv -f -- "$staged" "$mode_file"
    trap - EXIT
    echo "$mode"
    # One shared reader refreshes all enabled labels. A missing shell or
    # unloaded optional indicator must not turn a successful save into failure.
    omarchy-shell -q omarchy.agent-execution-default refresh >/dev/null 2>&1 || true
    ;;
  *)
    echo "Unknown agent execution mode: $1" >&2
    usage >&2
    exit 1
    ;;
esac
