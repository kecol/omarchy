#!/bin/bash

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] [--host|--container] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project" | omarchy agent prompt --container "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

agent_args=()
prompt=()
while (($#)); do
  case "$1" in
    --inline | --host | --container)
      agent_args+=("$1")
      shift
      ;;
    --)
      shift
      prompt+=("$@")
      break
      ;;
    *)
      prompt+=("$1")
      shift
      ;;
  esac
done

if ((${#prompt[@]} == 0)); then
  echo "Usage: omarchy agent prompt [--inline] [--host|--container] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${agent_args[@]}" --prompt "${prompt[*]}"
