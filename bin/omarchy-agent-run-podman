#!/bin/bash

# omarchy:summary=Run a configured coding agent in its rootless Podman harness
# omarchy:args=<agent> <harness> -- <command...>
# omarchy:hidden=true

set -euo pipefail

usage() {
  echo "Usage: omarchy-agent-run-podman <agent> <harness> -- <command...>" >&2
}

select_image=false
if [[ ${1:-} == "--select-image" ]]; then
  select_image=true
  shift
fi

if (( $# < 4 )) || [[ $3 != "--" ]]; then
  usage
  exit 1
fi

agent=$1
harness=$2
shift 3
command=("$@")

for value in "$agent" "$harness"; do
  if [[ ! $value =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
    echo "Invalid agent or harness name: $value" >&2
    exit 1
  fi
done

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if ! "$script_dir/omarchy-agent-container-doctor" --quick >/dev/null; then
  echo "Agent container mode is not safe to start." >&2
  echo "Run: omarchy agent container doctor" >&2
  exit 1
fi

# Prepare, inspect, and launch against the same local rootless engine.
podman() { command podman --remote=false "$@"; }
image_options=()
if [[ $select_image == "true" && ${OMARCHY_AGENT_MANAGED:-false} != "true" && ${OMARCHY_AGENT_ONESHOT:-false} != "true" && ${OMARCHY_AGENT_ONESHOT:-0} != "1" ]] && [[ -t 0 && -t 1 ]]; then
  image_options=(--interactive)
fi
# The selector returns an immutable ID, never the mutable :latest alias.
if image=$("$script_dir/omarchy-harness-select-image" "${image_options[@]}" "$agent" "$harness"); then
  :
else
  status=$?
  # A cancelled interactive selection exits without creating state or volumes.
  [[ $status == "130" ]] && exit 0
  exit "$status"
fi

workspace=$(realpath -e "$PWD")
workspace_hash=$(printf '%s' "$workspace" | sha256sum)
managed=${OMARCHY_AGENT_MANAGED:-false}
if [[ $managed == "true" ]]; then
  for variable in OMARCHY_AGENT_PROJECT_ID OMARCHY_AGENT_TASK_ID OMARCHY_AGENT_ASSIGNMENT_ID OMARCHY_AGENT_ROLE OMARCHY_AGENT_WORKSPACE; do
    if [[ -z ${!variable:-} ]]; then
      echo "Managed agent launch is missing $variable." >&2
      exit 1
    fi
  done
  if [[ $workspace != "$(realpath -e "$OMARCHY_AGENT_WORKSPACE")" ]]; then
    echo "Managed agent launch does not match its assignment workspace." >&2
    exit 1
  fi
  project_id=$OMARCHY_AGENT_PROJECT_ID
  task_id=$OMARCHY_AGENT_TASK_ID
  assignment_id=$OMARCHY_AGENT_ASSIGNMENT_ID
  role=$OMARCHY_AGENT_ROLE
  project_compact=${project_id//-/}
  assignment_compact=${assignment_id//-/}
  container_workspace="/workspace/${project_compact:0:12}/${assignment_compact:0:12}"
  home_volume="omarchy-agent-$agent-${assignment_compact:0:12}-home"
else
  project_id=${workspace_hash:0:16}
  task_id=
  assignment_id=
  role=
  container_workspace="/workspace/$project_id"
  home_volume="omarchy-agent-$agent-home"
fi

if ! podman volume exists "$home_volume"; then
  volume_args=(
    --label "org.omarchy.agent=$agent"
    --label "org.omarchy.harness=$harness"
  )
  if [[ $managed == "true" ]]; then
    volume_args+=(--label "org.omarchy.assignment=$assignment_id")
  fi
  podman volume create "${volume_args[@]}" "$home_volume" >/dev/null
fi

instance_id=$(< /proc/sys/kernel/random/uuid)
instance_compact=${instance_id//-/}
container_name="omarchy-agent-$agent-${instance_compact:0:12}"
policy=$("$script_dir/omarchy-agent-policy" --json)
memory_limit=$(jq -r '.resources.memory' <<<"$policy")
pids_limit=$(jq -r '.resources.pids' <<<"$policy")
cpus_limit=$(jq -r '.resources.cpus // ""' <<<"$policy")

harness_assets=()
if [[ $harness == "pi" && ${command[0]} == "pi" ]]; then
  # Expose only this public, read-only runtime asset, not the Omarchy tree or
  # host Pi home/auth. The extension uses the container's own Pi model runtime.
  recovery="$OMARCHY_PATH/default/agents/pi/model-recovery.ts"
  [[ -f $recovery && ! -L $recovery ]] || { echo "Pi model recovery asset is missing or unsafe." >&2; exit 1; }
  harness_assets=(--volume="$recovery:/opt/omarchy/pi/model-recovery.ts:ro,rprivate" --label=org.omarchy.harness.model-recovery=read-only)
  command=(pi --extension /opt/omarchy/pi/model-recovery.ts "${command[@]:1}")
fi

podman_args=(
  run
  --rm
  --pull=never
  --name="$container_name"
  --label=org.omarchy.managed=agent
  --label="org.omarchy.instance=$instance_id"
  --label="org.omarchy.agent=$agent"
  --label="org.omarchy.harness=$harness"
  --label=org.omarchy.runtime=podman
  --label="org.omarchy.project=$project_id"
  --label="org.omarchy.workspace.target=$container_workspace"
  --label="org.omarchy.workspace.managed=$managed"
  --label=org.omarchy.filesystem.workspace=read-write
  --label=org.omarchy.filesystem.source=unmounted
  --label=org.omarchy.filesystem.home=isolated-persistent-volume
  --label=org.omarchy.filesystem.root=read-only
  --label=org.omarchy.filesystem.tmp=ephemeral-tmpfs
  --label="org.omarchy.resources.memory=$memory_limit"
  --label="org.omarchy.resources.pids=$pids_limit"
  --memory="$memory_limit"
  --pids-limit="$pids_limit"
  --userns=keep-id
  --cap-drop=all
  --security-opt=no-new-privileges
  --read-only
  --tmpfs=/tmp:rw,nosuid,nodev,size=1g
  --tmpfs=/run:rw,nosuid,nodev,size=64m
  --workdir="$container_workspace"
  --hostname="agent-$agent"
  --env=OMARCHY_AGENT_IN_CONTAINER=1
  --env="OMARCHY_AGENT_MANAGED=$managed"
  --env="OMARCHY_AGENT_ONESHOT=${OMARCHY_AGENT_ONESHOT:-false}"
  --env=HOME=/home/agent
  --env=USER=agent
  --env=LOGNAME=agent
  --volume="$workspace:$container_workspace:rw,rprivate"
  --volume="$home_volume:/home/agent:U,rw"
  --entrypoint="${command[0]}"
)

podman_args+=("${harness_assets[@]}")

if [[ -n $cpus_limit ]]; then
  podman_args+=(
    --label="org.omarchy.resources.cpus=$cpus_limit"
    --cpus="$cpus_limit"
  )
fi

if [[ $managed == "true" ]]; then
  podman_args+=(
    --label="org.omarchy.task=$task_id"
    --label="org.omarchy.assignment=$assignment_id"
    --label="org.omarchy.role=$role"
  )
fi

if [[ ${OMARCHY_AGENT_ONESHOT:-false} != "true" && ${OMARCHY_AGENT_ONESHOT:-0} != "1" ]]; then
  podman_args+=(--interactive)
  if [[ -t 0 && -t 1 ]]; then
    podman_args+=(--tty)
  fi
fi
if [[ -n ${TERM:-} ]]; then
  podman_args+=(--env=TERM)
fi
if [[ -n ${COLORTERM:-} ]]; then
  podman_args+=(--env=COLORTERM)
fi

omarchy-agent-state start \
  "$instance_id" \
  "$agent" \
  "$harness" \
  podman \
  "$container_name" \
  "$project_id" \
  "$workspace" \
  "$container_workspace" \
  "$image" \
  running

set +e
podman "${podman_args[@]}" "$image" "${command[@]:1}"
exit_code=$?
set -e

if (( exit_code == 0 || exit_code == 130 || exit_code == 143 )); then
  final_status=stopped
else
  final_status=failed
fi
omarchy-agent-state finish "$instance_id" "$final_status" "$exit_code"
if [[ $managed == "true" ]]; then
  omarchy-agent-state assignment-status "$assignment_id" "$final_status"
fi
exit "$exit_code"
