#!/bin/bash

# omarchy:summary=Apply an assignment patch to its source checkout
# omarchy:args=<assignment> [--3way]
# omarchy:examples=omarchy task apply 019abc | omarchy task apply 019abc --3way

set -euo pipefail

if (( $# == 0 )); then
  echo "Usage: omarchy task apply <assignment> [--3way]" >&2
  exit 1
fi

three_way=false
selector=
for argument in "$@"; do
  if [[ $argument == "--3way" ]]; then
    three_way=true
  elif [[ -z $selector ]]; then
    selector=$argument
  else
    echo "Usage: omarchy task apply <assignment> [--3way]" >&2
    exit 1
  fi
done
if [[ -z $selector ]]; then
  echo "Usage: omarchy task apply <assignment> [--3way]" >&2
  exit 1
fi

matches=$(omarchy-agent-state assignment-get "$selector")
match_count=$(jq 'length' <<<"$matches")
if (( match_count == 0 )); then
  echo "No assignment matches: $selector" >&2
  exit 1
elif (( match_count > 1 )); then
  echo "More than one assignment matches: $selector" >&2
  exit 1
fi

assignment_id=$(jq -r '.[0].id' <<<"$matches")
project_path=$(jq -r '.[0].project_path' <<<"$matches")
base_commit=$(jq -r '.[0].base_commit' <<<"$matches")

if ! current_project=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "Apply a task from its source Git repository." >&2
  exit 1
fi
current_project=$(realpath -e "$current_project")
project_path=$(realpath -e "$project_path")
if [[ $current_project != "$project_path" ]]; then
  echo "This assignment belongs to: $project_path" >&2
  echo "Run from that checkout before applying it." >&2
  exit 1
fi

if [[ -n $(git -C "$project_path" status --porcelain) ]]; then
  echo "The source checkout has uncommitted changes. Commit or store them before applying a task." >&2
  exit 1
fi

current_head=$(git -C "$project_path" rev-parse HEAD)
if [[ $current_head != "$base_commit" && $three_way == "false" ]]; then
  echo "The source checkout is not at the task base commit." >&2
  echo "Expected: $base_commit" >&2
  echo "Current:  $current_head" >&2
  echo "Use --3way to apply against the current clean checkout." >&2
  exit 1
fi

patch_file=$(mktemp)
trap 'rm -f "$patch_file"' EXIT
omarchy-task-patch "$assignment_id" "$patch_file" >/dev/null

if [[ ! -s $patch_file ]]; then
  echo "Assignment has no changes to apply: $assignment_id" >&2
  exit 1
fi

if [[ $three_way == "true" ]]; then
  if ! git -C "$project_path" apply --3way "$patch_file"; then
    echo "Could not apply assignment cleanly with --3way." >&2
    echo "Resolve conflicts in $project_path, or abort with: git reset --hard HEAD" >&2
    omarchy-agent-state assignment-status "$assignment_id" conflict
    exit 1
  fi
else
  git -C "$project_path" apply --check "$patch_file"
  git -C "$project_path" apply "$patch_file"
fi
omarchy-agent-state assignment-status "$assignment_id" applied
printf 'Applied assignment %s to %s\n' "$assignment_id" "$project_path"
