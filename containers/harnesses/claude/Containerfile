FROM docker.io/library/archlinux:base AS claude-installer

ARG CLAUDE_VERSION
ENV MISE_DATA_DIR=/opt/mise
ENV MISE_CACHE_DIR=/var/cache/mise

# The registry shorthand selects Anthropic's native distribution. Resolve the
# executable through mise instead of assuming an archive's internal layout.
RUN pacman -Syu --noconfirm --needed ca-certificates mise \
    && mise install "claude@$CLAUDE_VERSION" \
    && mise exec "claude@$CLAUDE_VERSION" -- /bin/bash -c \
      'install -Dm755 "$(command -v claude)" /opt/claude/bin/claude' \
    && /opt/claude/bin/claude --version

FROM docker.io/library/archlinux:base

ARG HARNESS_UID=1000
ARG HARNESS_GID=1000

RUN pacman -Syu --noconfirm --needed \
      ca-certificates curl fd git jq openssh ripgrep \
    && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# Only the native executable crosses stages, never installer/account state.
COPY --from=claude-installer /opt/claude /opt/claude
RUN ln -s /opt/claude/bin/claude /usr/local/bin/claude \
    && groupadd --gid "$HARNESS_GID" agent \
    && useradd --uid "$HARNESS_UID" --gid "$HARNESS_GID" --create-home --shell /bin/bash agent \
    && install -d -o agent -g agent /workspace

ENV HOME=/home/agent
USER agent
WORKDIR /workspace
ENTRYPOINT ["claude"]
