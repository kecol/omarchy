FROM docker.io/library/archlinux:base AS codex-installer

ARG CODEX_VERSION
ENV MISE_DATA_DIR=/opt/mise
ENV MISE_CACHE_DIR=/var/cache/mise

RUN pacman -Sy --noconfirm --needed ca-certificates mise \
    && mise install "codex@$CODEX_VERSION" \
    && codex_dir=$(mise where "codex@$CODEX_VERSION") \
    && cp -a "$codex_dir" /opt/codex

FROM docker.io/library/archlinux:base

ARG HARNESS_UID=1000
ARG HARNESS_GID=1000

RUN pacman -Syu --noconfirm --needed \
      ca-certificates curl fd git jq openssh ripgrep \
    && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# Preserve the native package's companion executable, rg, and sandbox assets.
# No host installation or authentication home is copied into the build context.
COPY --from=codex-installer /opt/codex /opt/codex
RUN ln -s /opt/codex/bin/codex /usr/local/bin/codex \
    && groupadd --gid "$HARNESS_GID" agent \
    && useradd --uid "$HARNESS_UID" --gid "$HARNESS_GID" --create-home --shell /bin/bash agent \
    && install -d -o agent -g agent /workspace

ENV HOME=/home/agent
ENV PATH=/opt/codex/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER agent
WORKDIR /workspace
ENTRYPOINT ["codex"]
