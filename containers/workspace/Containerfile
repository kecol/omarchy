FROM docker.io/library/node:24-bookworm-slim

ARG WORKSPACE_UID=1000
ARG WORKSPACE_GID=1000

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git less openssh-client openssh-server patch pkg-config \
    procps python3 python3-venv ripgrep tini \
  && rm -rf /var/lib/apt/lists/* \
  && rm -f /etc/ssh/ssh_host_* \
  && userdel node \
  && (groupdel node || true) \
  && groupadd --gid "$WORKSPACE_GID" workspace \
  && useradd --uid "$WORKSPACE_UID" --gid "$WORKSPACE_GID" --create-home --shell /bin/bash --password x workspace \
  && mkdir -p /workspace /etc/omarchy-workspace \
  && touch /etc/omarchy-workspace/authorized_keys \
  && chown workspace:workspace /workspace

LABEL org.omarchy.workspace.version="1" \
  org.omarchy.workspace.uid="$WORKSPACE_UID" \
  org.omarchy.workspace.gid="$WORKSPACE_GID"

COPY sshd_config /etc/omarchy-workspace/sshd_config
COPY --chmod=0755 entrypoint.sh /usr/local/bin/omarchy-workspace-entrypoint

ENV HOME=/home/workspace CODEX_HOME=/home/workspace/.codex
USER workspace
WORKDIR /workspace
EXPOSE 2222
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/omarchy-workspace-entrypoint"]
