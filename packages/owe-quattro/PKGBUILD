# Maintainer: owe contributors
pkgname=owe-quattro
pkgver=0.2.13
pkgrel=1
pkgdesc="Quattro OWE: transient background handoff and owned renderer release"
provides=("owe=$pkgver")
conflicts=('owe')
arch=('x86_64' 'aarch64')
url="https://github.com/omacom/owe"
license=('MIT')
depends=('mpv' 'ffmpeg' 'wayland' 'libglvnd' 'libepoxy' 'systemd-libs' 'socat'
         'libmpv.so' 'libavformat.so' 'libavcodec.so' 'libavutil.so' 'libswscale.so')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'wayland-protocols')
checkdepends=('python')
optdepends=('intel-media-driver: VAAPI hardware decode on Intel GPUs'
            'libva-mesa-driver: VAAPI hardware decode on AMD GPUs')
source=("owe-$pkgver.tar.gz::https://github.com/omacom/owe/archive/refs/tags/v$pkgver.tar.gz"
        '90-owe-restart.hook'
        'package-restart'
        '0001-runtime-background-handoff.patch')
sha256sums=('f26a685340dbfe8f18841849d064693e546588f85bedee59e80d4e5378d6889a'
            '67e0aa7a5d61b5ec53830c8c778d398e2541406f4716216c4f2582462fb18b5d'
            'ef1fc780425343623c4a4ddd36cc58cd89ba8a71c528641f4b421db834a349cd'
            '40af5bf3a288c97905964c8942ff0e6eac2703309aaa1c8837ebd0a3ecf928f7')

prepare() {
  cd "$srcdir/owe-$pkgver"
  patch -p1 -i "$srcdir/0001-runtime-background-handoff.patch"
}

build() {
  meson setup build "$srcdir/owe-$pkgver" -Dbuildtype=release -Dprefix=/usr --wrap-mode=nodownload
  ninja -C build -j1 -v
}

check() {
  # transition's "both outputs show intermediate colors" wants at least three
  # blended frames from a 250 ms fade rendered with software GL. aarch64
  # builds run under QEMU user-mode emulation, which renders too few frames
  # in that window (reproduced 3/3 locally); it passes natively. Run every
  # other test there.
  local -a tests=()
  if [[ $CARCH == aarch64 ]]; then
    mapfile -t tests < <(meson test -C build --list | sed 's/^owe://' | grep -vx transition)
    (( ${#tests[@]} )) || return 1
  fi
  meson test -C build --print-errorlogs "${tests[@]}"
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 "$srcdir/90-owe-restart.hook" "$pkgdir/usr/share/libalpm/hooks/90-owe-restart.hook"
  install -Dm755 "$srcdir/package-restart" "$pkgdir/usr/lib/owe/package-restart"
  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|%h/.local/bin/owed|/usr/bin/owed|' "$srcdir/owe-$pkgver/systemd/owed.service" \
    >"$pkgdir/usr/lib/systemd/user/owed.service"
  install -Dm755 "$srcdir/owe-$pkgver/hooks/owe-idle" "$pkgdir/usr/bin/owe-idle"
  install -Dm644 "$srcdir/owe-$pkgver/hooks/theme-set.d/10-owe-sync" "$pkgdir/usr/share/owe/10-owe-sync"
  install -Dm644 "$srcdir/owe-$pkgver/config/config.toml" "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
